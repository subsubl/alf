[Unit]
Description=Tamagci Connected AI Companion Remote AI Server Agent
After=network-online.target mosquitto.service quixi-server.service
Wants=quixi-server.service mosquitto.service

[Service]
Type=simple
User=tamagci
WorkingDirectory=/opt/tamagci
EnvironmentFile=/opt/tamagci/server_agent/.env
ExecStart="/opt/tamagci/server_agent/.venv/bin/python" "/opt/tamagci/server_agent/main_server.py"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
