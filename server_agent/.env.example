# === OpenAI-Compatible API Keys (SERVER ONLY - NEVER COPY TO PI OR ESP32) ===
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-your-llm-key-here
LLM_MODEL=gpt-4o-mini

STT_BASE_URL=https://api.openai.com/v1
STT_API_KEY=sk-your-stt-key-here
STT_MODEL=whisper-1

TTS_BASE_URL=https://api.openai.com/v1
TTS_API_KEY=sk-your-tts-key-here
TTS_MODEL=tts-1
TTS_VOICE=alloy

# === Server QuIXI Gateway (ixian-platform/QuIXI) ===
QUIXI_REST_URL=http://127.0.0.1:8001
MQTT_HOST=127.0.0.1
MQTT_PORT=1883

# === Authorized Raspberry Pi Zero 2 W Ixian Wallet Address ===
PI_IXIAN_ADDRESS=1ReplaceWithYourPiQuIXIWalletAddress
# Set to true ONLY for local development when PI_IXIAN_ADDRESS is unset/placeholder
ALLOW_UNAUTHENTICATED_DEV=false
COMPANION_NAME=Tamagci
# Maximum buffered RX PCM audio per Spixi VoIP session (bytes; default 1920000 = 60s @ 16kHz PCM16)
MAX_RX_AUDIO_BYTES=1048576

# === Open WebUI-Inspired Companion Dashboard & OpenAI Bridge (/v1) ===
WEB_UI_ENABLED=true
WEB_UI_HOST=127.0.0.1
WEB_UI_PORT=8080
# Optional bearer token required for /api/* and /v1/* when non-empty
WEB_UI_TOKEN=
